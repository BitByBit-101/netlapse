# Files that are consumed by Linux must stay LF even when checked out on
# Windows. A CRLF shebang line makes the kernel look for an interpreter named
# "bash\r", which fails with a confusing "no such file or directory", and nginx
# and systemd both mis-parse trailing carriage returns.
*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.yml           text eol=lf

# Screenshots and other binaries must never be line-ending converted.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.db  binary
